# Copy to .env and fill in.
OPENAI_API_KEY=sk-...

# gpt-4o-mini is cheap and handles this fine thanks to the validation loop.
# Bump to gpt-4.1 or gpt-4o if you want better line-item extraction on messy PDFs.
OPENAI_MODEL=gpt-4o-mini

AGENT_MAX_STEPS=12
AGENT_TEMPERATURE=0.0

MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=25
PAGE_PREVIEW_CHARS=2500

LOG_LEVEL=INFO
