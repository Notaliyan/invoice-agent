# Copy to .env and fill in.
OPENAI_API_KEY=sk-...

# gpt-4o-mini is cheap and handles this fine thanks to the validation loop.
# Bump to gpt-4.1 or gpt-4o if you want better line-item extraction on messy PDFs.
OPENAI_MODEL=gpt-4o-mini

# Optional: run against another OpenAI-compatible provider instead of OpenAI.
# Leave empty for OpenAI. With a base URL set, OPENAI_API_KEY is that provider's
# key and OPENAI_MODEL one of its models. Free-tier example (Google Gemini,
# key from https://aistudio.google.com):
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_MODEL=gemini-3.5-flash-lite
OPENAI_BASE_URL=

# Retries on rate limits, with backoff. Free tiers with a low requests-per-minute
# cap need more (10 rides out a one-minute window).
OPENAI_MAX_RETRIES=2

AGENT_MAX_STEPS=12
AGENT_TEMPERATURE=0.0

MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=25
PAGE_PREVIEW_CHARS=2500

LOG_LEVEL=INFO

# n8n (docker compose only): where the workflow announces each result. Any URL
# that accepts {"text": "..."}, such as a Slack incoming webhook. Unset, it
# goes to this API's own /notifications inbox.
# NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/...

# Where extractions are stored. SQLite needs nothing installed. For Postgres:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/invoice_agent
# Leave empty to turn storage off. docker compose ignores this and uses its
# own Postgres service.
DATABASE_URL=sqlite:///./data/invoice_agent.db

# Langfuse tracing + evals (optional). Leave the keys empty to run without it.
# Create a project at https://cloud.langfuse.com -> Settings -> API Keys.
# EU region: https://cloud.langfuse.com   US region: https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Shown as a filter in Langfuse; set to "production" on the deployed service.
LANGFUSE_ENVIRONMENT=development
